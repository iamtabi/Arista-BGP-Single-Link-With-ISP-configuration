Conf t
hostname R5

exit
interface fastethernet 0/0
ip address 172.16.2.1 255.255.255.0
ip ospf 100 area 0.0.0.0
no shutdown

exit
interface fastethernet 1/0
ip address 192.168.2.2 255.255.255.0
 ip ospf  100 area 0.0.0.0
no shut
exit
interface fastethernet 2/0
no shutdown
 ip address 192.168.1.2 255.255.255.0
 ip ospf 100 area 0.0.0.0
no shut
exit

router bgp 174
 no bgp default ipv4-unicast
 neighbor 172.16.2.2 remote-as 20007
 neighbor 192.168.1.1 remote-as 174
 neighbor 192.168.2.1 remote-as 174
address-family ipv4
  network 192.168.1.0
  network 192.168.2.0
  neighbor 172.16.2.2 activate
  neighbor 172.16.2.2 default-originate
  neighbor 172.16.2.2 route-map GSHUT-IN in
  neighbor 192.168.1.1 activate
  neighbor 192.168.2.1 activate
exit
ip community-list standard GSHUT permit 429490176
ip route 0.0.0.0 0.0.0.0 Null0
ip prefix-list DEFAULT_ONLY seq 5 permit 0.0.0.0/0
route-map DEFAULT_TO_SW1 permit 5
 match ip address prefix-list DEFAULT_ONLY
exit
route-map GSHUT-IN permit 10
 match community GSHUT
 set local-preference 0
exit
route-map GSHUT-IN permit 20
