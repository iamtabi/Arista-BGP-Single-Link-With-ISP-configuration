Conf t
Ip routing
hostname DMZ-SW02
no spanning-tree vlan-id 4094
vlan 2
name iBGP-connectivity
vlan 100
   name public-subnet
vlan 4094
   trunk group DMZ-SW01-SW02
exit
interface Port-Channel10
   description port channel between  DMZ-SW02&Core-SW01
   switchport trunk allowed vlan 100,2,4094
   switchport mode trunk
   switchport trunk group DMZ-SW01-SW02
exit
interface Port-Channel11
   description Port channel to Core Switches
   switchport trunk allowed vlan 100
   switchport mode trunk
   mlag 11
exit
interface Ethernet1
   channel-group 10 mode active
exit
interface Ethernet2
   channel-group 10 mode active
exit
interface Ethernet3
   channel-group 10 mode active
exit
interface Ethernet4
   channel-group 11 mode active
exit
interface Ethernet5
   channel-group 11 mode active
exit
interface Ethernet6
   no switchport
   ip address 172.16.3.2/24
interface Vlan2
   ip address 20.20.20.2/24
exit
interface Vlan100
   ip address 10.100.100.4/24
   ip virtual-router address 10.100.100.1
exit
ip virtual-router mac-address 00:1c:73:00:09:99
interface Vlan4094
   description Vlan between DMZ switches
   ip address 172.16.11.2/30
exit
ip prefix-list DEFAULT_ONLY seq 5 permit 0.0.0.0/0
ip prefix-list Only-Public seq 10 permit 10.100.100.0/24

mlag configuration
   domain-id mlag-SW01-SW02
   local-interface Vlan4094
   peer-address 172.16.11.1
   peer-link Port-Channel10
exit


route-map SECONDARY_ISP2 permit 10
   match ip address prefix-list DEFAULT_ONLY
   set local-preference 100
exit
route-map iBGP permit 15
   match ip address prefix-list DEFAULT_ONLY
exit
router bgp 20007
   neighbor 20.20.20.1 remote-as 20007
   neighbor 20.20.20.1 next-hop-self
   neighbor 20.20.20.1 send-community
   neighbor 172.16.3.1 remote-as 6939
   neighbor 172.16.3.1 route-map SECONDARY_ISP2 in
   neighbor 172.16.3.1 route-map Only-Public out
   neighbor 172.16.3.1 send-community
   network 10.100.100.0/24
address-family ipv4
      neighbor 20.20.20.1 route-map iBGP in
      neighbor 20.20.20.1 default-originate
